{
 "unparsed_references": [
  {
   "version": "bkv.v285",
   "note": "Thess. 5, 21."
  },
  {
   "version": "bkv.v285",
   "note": "Tim. 2, 29."
  },
  {
   "version": "bkv.v285",
   "note": "Kor. 4, 16."
  },
  {
   "version": "bkv.v77",
   "note": "Vgl. über die Abschwörung De myst. 2, 5. 7."
  },
  {
   "version": "bkv.v77",
   "note": "Sieh unten 8, 31. Die förmliche Rechtfertigung der Zurückstellung wohl deshalb, weil Basilius die bezügliche Ausführung bereits an dieser Stelle bringt."
  },
  {
   "version": "bkv.v77",
   "note": "Schenkl, S. 53 verweist hier auf Reifferscheid, Suet. rel. p. 442 sq. Sieh hiergegen unten zu Exam. VI 4, 24."
  },
  {
   "version": "bkv.v77",
   "note": "Zu Kap. V: Vgl. zu 5, 18 u. 21 Basil., l. c. 10."
  },
  {
   "version": "bkv.v77",
   "note": "Die Wendung ‚prosapiae veteris‘ bei Sall., bell. Iug. 85, 10."
  },
  {
   "version": "bkv.v77",
   "note": "Zu Kap. VIII: Vgl. zu Kap. 8, 33 f. Basil., l. c. 3."
  },
  {
   "version": "bkv.v77",
   "note": "Zu Kap. XIII: Vgl. zu 13, 55 f. Basil., l. c. 7."
  },
  {
   "version": "bkv.v77",
   "note": "Zu Kap. XVI: Vgl. zu Kap. 16, 66 und 69 Basil., l. c. 6 u. 9 (Schluß)."
  },
  {
   "version": "bkv.v77",
   "note": "Die allegorische Deutung, die Ambr. De Jac. II, 1, 4 selbst vorträgt, wird also auch an der obigen Stelle nicht ausgeschlossen."
  },
  {
   "version": "bkv.v77",
   "note": "Vgl. zu ‚coeli nubila detergere‘ Hor., od. I 7, 15 f. Eine ganz ähnliche Wendung Exam. VI 4, 20."
  },
  {
   "version": "bkv.v142",
   "note": "der Genesis-Worte 1,1"
  },
  {
   "version": "bkv.v142",
   "note": "Kleanthes von Assos, ein Schüler Zenons (✝ ca. 764 v. Chr.), undChrysipp vonTarsus (✝ ca. 212 v. Chr.) bekannten sich nach Ciceros Angaben (de natura deorum 1, 14.15) zu dieser Anschauung."
  },
  {
   "version": "bkv.v142",
   "note": "vgl. Origenes, de principiis II, 1,3"
  },
  {
   "version": "bkv.v142",
   "note": "vgl. Plato, Timäus c. 14; Plotin, ennead. II, 7,10-12"
  },
  {
   "version": "bkv.v142",
   "note": "vgl. Arist., Meteor. 1,3"
  },
  {
   "version": "bkv.v142",
   "note": "so ähnlich Anaximenes, Anaxagoras und Demokrit; vgl. Arist. de coelo II,13,16"
  },
  {
   "version": "bkv.v142",
   "note": "wie etwa Thales; vgl. Arist. 1.c. II, 13,18"
  },
  {
   "version": "bkv.v142",
   "note": "vgl. Arist. de coelo II, 14,4"
  },
  {
   "version": "bkv.v142",
   "note": "Vgl. Arist., de gen. anim. II. 8, 11 und zum „fünften” Element des Aristoteles vgl. Cicero, Tusc. Disp. I, 10."
  },
  {
   "version": "bkv.v142",
   "note": "Nach Ambrosius (Hexaemeron I. 9,33) „spitzen die Taucher das Öl aus dem Munde aus, um die verborgene Tiefe einigermaßen aufzuhellen!. Vgl. Plinius, hist. nat. II,106"
  },
  {
   "version": "bkv.v142",
   "note": "Nur diese Wiedergabe entspricht dem Grundtext. Die ganz ähnlich klingenden Äußerungen des Ambrosius (Hexaemeron I,10,37) bestätigen das."
  },
  {
   "version": "bkv.v142",
   "note": "Demokrits Auffassung (vgl. Cicero Acad. II,55), und vor ihm auch Anaximander (Diogenes Laertius II, 1, 2)."
  },
  {
   "version": "bkv.v142",
   "note": "Ein mythisches Gedankengebilde. Aristoteles glaubte zwar an die reale Existenz eines solchen Gebirges (Meteorol. I, 13; II, 1, 14). „Es wäre müßig, auf der Karte nach ihm zu suchen. Nirgendwo und wann … hat man wirklich bodenständig ein Gebirge die Ripen genannt. Namen so gut wie Berge sind eine reine Fiktion des spekulierenden Geistes” (Kießling in seinem ausführlichen Artikel ϱίπαια ὄϱη) in Pauly-Wissowa a. a. O. col. 846-918)"
  },
  {
   "version": "bkv.v142",
   "note": "vgl. Plinius 1. C. XX, 199,201"
  },
  {
   "version": "bkv.v142",
   "note": "nämlich durch Jesias in c. 5,1"
  },
  {
   "version": "bkv.v142",
   "note": "Ambrosius (Hexaemeron III, 13,56) erzählt dieselbe Operation"
  },
  {
   "version": "bkv.v142",
   "note": "Sinn: Der Feigenbaum hat von sich aus nicht die Kraft, trotz schädlicher Einwirkungen der Luft oder der Hitze die Frucht zu behalten bis zur vollen Reife. Darum muß mit diesem künstlichen Mittel nachgeholfen werden. (Vgl. Ambrosius, Hexaemeron III, 13, 56.)"
  },
  {
   "version": "bkv.v142",
   "note": "vgl. Arist. hist. Anim. VIII, 13,19"
  },
  {
   "version": "bkv.v142",
   "note": "Ambrosius (Hexaemeron V. 9,24) schildert den Seeigel als Wetterpropheten etwas abweichend von obiger Darstellung. Basilius erinnert hier an Oppianus, de pisc. II, 225; Aelian, de nat. anim. VII, 33, Plinius, hist. nat. IX, 5"
  },
  {
   "version": "bkv.v142",
   "note": "Basilius redet von einem Bienenkönig (wie auch Ambrosius, Hexaemeron V,21,68; cfr. Vergil, Georg. IV,201)"
  },
  {
   "version": "bkv.v142",
   "note": "vgl. röm 12,17.21"
  },
  {
   "version": "bkv.v142",
   "note": "nämlich: Gesundheit. - Hier klingt die Lehre der Stoiker durch; vgl. Cicero, de fin. III,7,26, und de nat. deorum I. 14; vgl. auch Horaz, Ep. I, X, 12"
  }
 ],
