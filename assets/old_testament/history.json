      "dating": {
        "from": -539,
        "to": -101,
        "label": "ab 539 v. Chr.",
        "approx": true,
        "note": "Folie 19 setzt die nachexilische Zeit mit der Machtübernahme der Perser ab 539 an; Folie 20 nennt für die exilische und nachexilische Zeit das 6.–2. Jh. v. Chr."
      },
      "statements": [
        {
          "unit": "unit.01",
          "slides": [
            19
          ],
          "text": "Die Folie fasst unter „Nachexilische Zeit“ zusammen: Machtübernahme der Perser (ab 539), Alexander der Große (333), Sieg der Makkabäer (164)."
        },
        {
          "unit": "unit.01",
          "slides": [
            20
          ],
          "text": "Exilische und nachexilische Zeit (6.–2. Jh. v. Chr.): Nach der Vorlesung erhalten die biblischen Bücher in dieser Zeit ihre Gestalt."
        }
      ]
    },
