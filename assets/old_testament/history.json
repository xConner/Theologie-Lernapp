  "items": [
    {
      "id": "period.koenigszeit",
      "kind": "period",
      "track": "history",
      "name": "Königszeit",
      "dating": {
        "from": -1000,
        "to": -501,
        "label": "10.–6. Jh. v. Chr.",
        "approx": true
      },
      "statements": [
        {
          "unit": "unit.01",
          "slides": [
            19
          ],
          "text": "Die Folie fasst unter „Königszeit“ zusammen: Entstehung der Lokalkönigtümer Israel und Juda (10. Jh.), Untergang des Nordreiches (722) und des Südreiches (587)."
        },
        {
          "unit": "unit.01",
          "slides": [
            20
          ],
          "text": "Königszeit (10.–6. Jh. v. Chr.): Zeit der Vorstufen der biblischen Bücher (Erzählkränze, Annalennotizen, Sammlungen von Prophetenworten, einzelne Psalmen, Weisheitssprüche)."
        }
      ]
    },
    {
      "id": "period.exil",
      "kind": "period",
      "track": "history",
      "name": "Babylonisches Exil",
      "datingBy": {
        "lecture": {
          "from": -587,
          "to": -539,
          "label": "zwischen 587 und 539 v. Chr.",
          "note": "Die Folie nennt für das Exil keine eigenen Jahreszahlen; es steht zwischen dem Untergang des Südreiches (587) und der Machtübernahme der Perser (ab 539)."
        },
        "bibelkunde": {
          "from": -587,
          "to": -539,
          "label": "zwischen 587/6 und 539 v. Chr.",
          "note": "Die Folie nennt für das Exil keine eigenen Jahreszahlen; es steht zwischen der 2. Eroberung Jerusalems (587/6) und dem Sieg des Kyros (539)."
        }
      },
      "statements": [
        {
          "unit": "unit.01",
          "slides": [
            19
          ],
          "text": "„Babylonisches Exil“ steht auf der Folie zwischen dem Untergang des Südreiches (587) und der Machtübernahme der Perser (ab 539)."
        },
        {
          "unit": "bk.01",
          "slides": [
            27
          ],
          "text": "„(Babylonisches) Exil“ steht auf der Folie zwischen der 2. Eroberung Jerusalems (587/6) und dem Sieg des Kyros (539)."
        }
      ]
    },
    {
      "id": "period.nachexilisch",
