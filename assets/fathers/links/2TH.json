1b38e","v":"npnf.augustinus.sermones_nt","w":"augustinus.sermones_nt","a":"augustinus_von_hippo","s":77,"p":[8,8],"r":[3,2],"k":"quotation","m":"editionCitation","c":"high","cited":"2 Thess. iii. 2."},{"id":"db660c7e7f58","v":"npnf.augustinus.in_iohannem","w":"augustinus.in_iohannem","a":"augustinus_von_hippo","s":29,"p":[8,8],"r":[2,4],"k":"quotation","m":"editionCitation","c":"high","cited":"2 Thess. ii. 4."},{"id":"9f7ba2a222ab","v":"npnf.augustinus.in_iohannem","w":"augustinus.in_iohannem","a":"augustinus_von_hippo","s":52,"p":[12,12],"r":[3,2],"k":"quotation","m":"editionCitation","c":"high","cited":"2 Thess. iii. 2."},{"id":"032cd6412b17","v":"npnf.augustinus.in_iohannem","w":"augustinus.in_iohannem","a":"augustinus_von_hippo","s":115,"p":[4,4],"r":[3,2],"k":"quotation","m":"editionCitation","c":"high","cited":"2 Thess. iii. 2."},{"id":"6cb72922f572","v":"npnf.augustinus.in_iohannem","w":"augustinus.in_iohannem","a":"augustinus_von_hippo","s":122,"p":[3,3],"r":[3,8],"k":"quotation","m":"editionCitation","c":"high","cited":"2 Thess. iii. 8."},{"id":"87f255cf5032","v":"npnf.augustinus.in_epistulam_iohannis","w":"augustinus.in_epistulam_iohannis","a":"augustinus_von_hippo","s":3,"p":[5,5],"r":[2,2],"k":"quotation","m":"editionCitation","c":"high","cited":"So ἀντικείμενος 2 Thess. ii. 2, 3, and so the word seems to be interpreted by Tertull. de Praescr. Haer . 4, Antichristi-Christi rebelles . And this is alleged by Theophylact as the traditional interpretation of the Greek Church: πάντως o9 ψεύστης ἐναντίος ῶν τῆ αληθεί́α ήτοι τωσΧριστῶ ἀντιχριστός ἐστι . \"Certainly `Antichrist 0' is the Liar opposed to the Truth, i.e. to Christ.\" So Oecumenius. But by earlier authorities it is taken in the sense of \"false-Christ,\" or, one that gives himself out for Christ with denial of Jesus Christ. Thus in the Acta Martyrum: Dicit autem Apostolus: Si Satanus , &c. Undeet Antichristus Quasi-Christus . \"The Apostle saith: If Satan be transfigured as an angel of light, it is no great matter if his ministers be transfigured.\" Whence also \"Antichrist\" means \"seeming-Christ.\" And St. Hippolyt. Portuensis de Antichristo , 6, κατὰ πάντα ἐξομοιοῦσθαι βούλεται o9 πλάνος τῶ υἱῶ τοῦ Θεοῦ . \"In all things the deceiver will needs make himself like the Son of God.\" See Mr. Greswell's Exposition of the Parables , i. p. 372. ff."},{"id":"5d9f710953fe","v":"npnf.athanasius.orationes_contra_arianos","w":"athanasius.orationes_contra_arianos","a":"athanasius_von_alexandrien","s":13,"p":[2,2],"r":[2,1],"k":"quotation","m":"editionCitation","c":"high","cited":"Vid. 1 Thess. iv. 13; 2 Thess. ii. 1, &c."},{"id":"2bee6e303b92","v":"npnf.athanasius.orationes_contra_arianos","w":"athanasius.orationes_contra_arianos","a":"athanasius_von_alexandrien","s":23,"p":[2,2],"r":[2,8],"k":"quotation","m":"editionCitation","c":"high","cited":"paranomoj anomoj . 2 Thess. ii. 8."},{"id":"d0547a8c4773","v":"npnf.athanasius.orationes_contra_arianos","w":"athanasius.orationes_contra_arianos","a":"athanasius_von_alexandrien","s":28,"p":[9,9],"r":[2,1],"k":"quotation","m":"editionCitation","c":"high","cited":"Vid. 2 Thess. ii. 1, 2 Thess. ii. 2."},{"id":"7a6a5b7b4515","v":"npnf.athanasius.orationes_contra_arianos","w":"athanasius.orationes_contra_arianos","a":"athanasius_von_alexandrien","s":28,"p":[9,9],"r":[2,2],"k":"quotation","m":"editionCitation","c":"high","cited":"Vid. 2 Thess. ii. 1, 2 Thess. ii. 2."},{"id":"c057d3a3e453","v":"npnf.athanasius.historia_arianorum","w":"athanasius.historia_arianorum","a":"athanasius_von_alexandrien","s":20,"p":[0,0],"r":[2,8],"k":"quotation","m":"editionCitation","c":"high","cited":"2 Thess. ii. 8."},{"id":"c0f597e10231","v":"npnf.athanasius.historia_arianorum","w":"athanasius.historia_arianorum","a":"athanasius_von_alexandrien","s":20,"p":[0,0],"r":[2,3],"k":"quotation","m":"editionCitation","c":"high","cited":"2 Thess. ii. 3."},{"id":"7087e505562e","v":"npnf.athanasius.historia_arianorum","w":"athanasius.historia_arianorum","a":"a