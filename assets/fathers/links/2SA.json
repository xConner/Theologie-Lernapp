em","a":"tertullian","s":3,"p":[41,41],"r":[24,1],"k":"quotation","m":"editionCitation","c":"high","cited":"In 1 Kings xi. 14. \"the Lord\" is said to have done this. Comp. 2 Sam. xxiv. 1 with 1 Chron. xxi. i."},{"id":"b4dcacfd7667","v":"anf.tertullian.adversus_marcionem","w":"tertullian.adversus_marcionem","a":"tertullian","s":4,"p":[23,23],"r":[12,13],"k":"quotation","m":"editionCitation","c":"high","cited":"2 Sam. xii. 13."},{"id":"7901286f5ebf","v":"anf.tertullian.adversus_marcionem","w":"tertullian.adversus_marcionem","a":"tertullian","s":4,"p":[77,77],"r":[5,6,5,8],"k":"quotation","m":"editionCitation","c":"high","cited":"See 2 Sam. v. 6-8."},{"id":"2bb7be57e301","v":"anf.tertullian.adversus_marcionem","w":"tertullian.adversus_marcionem","a":"tertullian","s":4,"p":[77,77],"r":[5,8],"k":"quotation","m":"editionCitation","c":"high","cited":"See 2 Sam. v. 8."},{"id":"8f5725d4882e","v":"anf.tertullian.adversus_marcionem","w":"tertullian.adversus_marcionem","a":"tertullian","s":5,"p":[27,27],"r":[12,13],"k":"quotation","m":"editionCitation","c":"high","cited":"2 Sam. xii. 13."},{"id":"61f98a887020","v":"anf.origenes.contra_celsum","w":"origenes.contra_celsum","a":"origenes","s":2,"p":[169,169],"r":[22,44],"k":"quotation","m":"editionCitation","c":"high","cited":"Cf. 2 Sam. xxii. 44, 45."},{"id":"583425c816c4","v":"csel.augustinus.confessiones","w":"augustinus.confessiones","a":"augustinus_von_hippo","s":22,"p":[12,12],"r":[23,15],"k":"quotation","m":"editionCitation","c":"medium","cited":"II Reg. 23,15; Matth. 4, 3; Num. 11,1; Rom. 8, 84; Io. 16, 33; Ps. 138,16; Iob 7, 1","note":"Stellenangabe im Apparat der Ausgabe (Seite; Absatz ungefähr)"},{"id":"9e122f79fca1","v":"csel.cyprian.de_dominica_oratione","w":"cyprian.de_dominica_oratione","a":"cyprian_von_karthago","s":2,"p":[8,8],"r":[24,11],"k":"quotation","m":"editionCitation","c":"medium","cited":"II Reg. 24,11; Dan. 1,1; Es. 42, 25; I Reg. 11, 23; Io. 19,11; Matth. 26, 41","note":"Stellenangabe im Apparat der Au