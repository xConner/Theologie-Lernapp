us.comm_gal","w":"chrysostomus.comm_gal","a":"johannes_chrysostomus","s":7,"p":[25,25],"r":[16,19],"k":"quotation","m":"editionCitation","c":"high","cited":"Luke xvi: 19"},{"id":"94e895732983","b":"ROM","v":"npnf.chrysostomus.comm_gal","w":"chrysostomus.comm_gal","a":"johannes_chrysostomus","s":7,"p":[27,27],"r":[16,22],"k":"quotation","m":"editionCitation","c":"high","cited":"Rom. xvi: 22"},{"id":"cb5a78f18b71","b":"2TI","v":"npnf.chrysostomus.comm_gal","w":"chrysostomus.comm_gal","a":"johannes_chrysostomus","s":7,"p":[32,32],"r":[4,22],"k":"quotation","m":"editionCitation","c":"high","cited":"[So also Lightfoot, who says, \"with your spirit\" is probably in reference to the carnal religion of the Galatians, but this cannot be pressed because the same form of benediction occurs in Philem. 25; 2 Tim. iv:22. Meyer denies there is any such allusion at all. G. A.]"},{"id":"277c9519be32","b":"2TI","v":"npnf.chrysostomus.comm_gal","w":"chrysostomus.comm_gal","a":"johannes_chrysostomus","s":7,"p":[37,37],"r":[4,2],"k":"quotation","m":"editionCitation","c":"high","cited":"2 Tim. iv: 2"},{"id":"e7b9eeeee4e1","b":"2TI","v":"npnf.chrysostomus.comm_gal","w":"chrysostomus.comm_gal","a":"johannes_chrysostomus","s":7,"p":[37,37],"r":[2,25],"k":"quotation","m":"editionCitation","c":"high","cited":"2 Tim. ii: 25"},{"id":"5c43fba6b33e","b":"2TI","v":"npnf.chrysostomus.comm_gal","w":"chrysostomus.comm_gal","a":"johannes_chrysostomus","s":7,"p":[37,37],"r":[2,26],"k":"quotation","m":"editionCitation","c":"high","cited":"2 Tim. ii: 26"}]}
