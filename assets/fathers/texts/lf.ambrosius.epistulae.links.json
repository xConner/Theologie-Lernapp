lae","a":"ambrosius_von_mailand","s":21,"p":[9,9],"r":[25,8],"k":"quotation","m":"editionCitation","c":"high","cited":"Num. xxv. 8."},{"id":"8fc01921e55f","b":"JDG","v":"lf.ambrosius.epistulae","w":"ambrosius.epistulae","a":"ambrosius_von_mailand","s":21,"p":[13,13],"r":[13,8],"k":"quotation","m":"editionCitation","c":"high","cited":"Judges xiii. 8."},{"id":"8bb028904836","b":"JDG","v":"lf.ambrosius.epistulae","w":"ambrosius.epistulae","a":"ambrosius_von_mailand","s":21,"p":[25,25],"r":[15,16],"k":"quotation","m":"editionCitation","c":"high","cited":"Judges xv. 16."},{"id":"f1c833a3c5b2","b":"JDG","v":"lf.ambrosius.epistulae","w":"ambrosius.epistulae","a":"ambrosius_von_mailand","s":21,"p":[30,30],"r":[16,13],"k":"quotation","m":"editionCitation","c":"high","cited":"b The, words 'quasi in cubitum intexti' are probably from the Old Latin Version of the Bible. Field, on Origen's Hexapla in Ioe. (Judg. xvi. 13.) mentions that some MSS of LXX read ἐαν ὑφάνης ὡσει πῆχυν or ὡς ἐπὶ πῆχυν, which may very well have been translated by some such words as the above, in the Old Latin Version which S. Ambrose used."},{"id":"c2d029ebd615","b":"JDG","v":"lf.ambrosius.epistulae","w":"ambrosius.epistulae","a":"ambrosius_von_mailand","s":21,"p":[32,32],"r":[16,20],"k":"quotation","m":"editionCitation","c":"high","cited":"Judges xvi. 20."},{"id":"389d8a9f2cff","b":"JDG","v":"lf.ambrosius.epistulae","w":"ambrosius.epistulae","a":"ambrosius_von_mailand","s":21,"p":[33,33],"r":[16,28],"k":"quotation","m":"editionCitation","c":"high","cited":"Judges xvi. 28."},{"id":"06c0adcef214","b":"JDT","v":"lf.ambrosius.epistulae","w":"ambrosius.epistulae","a":"ambrosius_von_mailand","s":22,"p":[4,4],"r":[14,17],"k":"quotation","m":"editionCitation","c":"low","cited":"a The expression 'principes virtutum' seems to be a phrase from the Old Testament. In the Vulgate we find 'rex virtutum' Ps. lxvii, (lxviii. E.V.) 13, whore the E.V. has 'kings of armies,' and in Judith xiv. 17 (19 K.V.) 'Quod quum audissent, principes virtutis Assyriorum,' and in 1 Macc. v. 56. 'Azarias princeps virtutis.' The 'comites consistoriani' formed a sort of cabinet (consistorium) or privy council to the Emperor. The Benedictine Editors take 'principes virtutum' as meaning the Magistri militum, but the absence of any conjunction is against this.","note":"Stellenangabe der Ausgabe (englische Zählung, nicht prüfbar)"},{"id":"994ed59adc87","b":"1MA","v":"lf.ambrosius.epistulae","w":"ambrosius.epistulae","a":"ambrosius_von_mailand","s":22,"p":[4,4],"r":[5,56],"k":"quotation","m":"editionCitation","c":"low","cited":"a The expression 'principes virtutum' seems to be a phrase from the Old Testament. In the Vulgate we find 'rex virtutum' Ps. lxvii, (lxviii. E.V.) 13, whore the E.V. has 'kings of armies,' and in Judith xiv. 17 (19 K.V.) 'Quod quum audissent, principes virtutis Assyriorum,' and in 1 Macc. v. 56. 'Azarias princeps virtutis.' The 'comites consistoriani' formed a sort of cabinet (consistorium) or privy council to the Emperor. The Benedictine Editors take 'principes virtutum' as meaning the Magistri militum, but the absence of any conjunction is against this.","note":"Stellenangabe der Ausgabe (englische Zählung, nicht prüfbar)"},{"id":"e07bcaf85110","b":"PSA","v":"lf.ambrosius.epistulae","w":"ambrosius.epistulae","a":"ambrosius_von_mailand","s":22,"p":[15,15],"r":[17,7],"k":"quotation","m":"editionCitation","c":"medium","cited":"Ps. xvii. 7."},{"id":"a1828be654fd","b":"JOB","v":"lf.ambrosius.epistulae","w":"ambrosius.epistulae","a":"ambrosius_von_mailand","s":22,"p":[17,17],"r":[2,9],"k":"quotation","m":"editionCitation","c":"high","cited":"Job ii. 9."},{"id":"a7f9889e89b7","b":"GEN","v":"lf.ambrosius.epistulae","w":"ambrosius.epistulae","a":"ambrosius_von_mailand","s":22,"p":[18,18],"r":[3,9],"k":"quotation","m":"editionCitation","c":"high","cited":"Gen. iii. 9."},{"id":"d9548872439c","b":"MAT","v":"lf.ambrosius.epistulae","w":"ambrosius.epistulae","a":"ambrosius_von_mailand","s":22,