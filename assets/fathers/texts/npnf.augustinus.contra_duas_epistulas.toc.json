ies.","c":1,"path":["Book 4"],"url":"https://github.com/HistoricalChristianFaith/Writings-Database/tree/master/Augustine%20of%20Hippo/A%20Treatise%20Against%20Two%20Letters%20of%20the%20Pelagians"},{"n":117,"t":"Chapter 22.-Further References to Cyprian.","c":1,"path":["Book 4"],"url":"https://github.com/HistoricalChristianFaith/Writings-Database/tree/master/Augustine%20of%20Hippo/A%20Treatise%20Against%20Two%20Letters%20of%20the%20Pelagians"},{"n":118,"t":"Chapter 23.-Further References to Cyprian.","c":1,"path":["Book 4"],"url":"https://github.com/HistoricalChristianFaith/Writings-Database/tree/master/Augustine%20of%20Hippo/A%20Treatise%20Against%20Two%20Letters%20of%20the%20Pelagians"},{"n":119,"t":"Chapter 24.-The Dilemma Proposed to the Pelagians.","c":1,"path":["Book 4"],"url":"https://github.com/HistoricalChristianFaith/Writings-Database/tree/master/Augustine%20of%20Hippo/A%20Treatise%20Against%20Two%20Letters%20of%20the%20Pelagians"},{"n":120,"t":"Chapter 25 [IX.]-Cyprian's Testimonies Concerning God's Grace.","c":1,"path":["Book 4"],"url":"https://github.com/HistoricalChristianFaith/Writings-Database/tree/master/Augustine%20of%20Hippo/A%20Treatise%20Against%20Two%20Letters%20of%20the%20Pelagians"},{"n":121,"t":"Chapter 26.-Further Appeals to Cyprian's Teaching.","c":1,"path":["Book 4"],"url":"https://github.com/HistoricalChristianFaith/Writings-Database/tree/master/Augustine%20of%20Hippo/A%20Treatise%20Against%20Two%20Letters%20of%20the%20Pelagians"},{"n":122,"t":"Chapter 27 [X.] - Cyprian's Testimonies Concerning the Imperfection of Our Own Righteousness.","c":1,"path":["Book 4"],"url":"https://github.com/HistoricalChristianFaith/Writings-Database/tree/master/Augustine%20of%20Hippo/A%20Treatise%20Against%20Two%20Letters%20of%20the%20Pelagians"},{"n":123,"t":"Chapter 28.-Cyprian's Orthodoxy Undoubted.","c":1,"path":["Book 4"],"url":"https://github.com/HistoricalChristianFaith/Writings-Database/tree/master/Augustine%20of%20Hippo/A%20Treatise%20Against%20Two%