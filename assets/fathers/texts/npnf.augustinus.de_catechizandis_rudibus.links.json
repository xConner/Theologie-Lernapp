d":"f3f97f666816","b":"ACT","v":"npnf.augustinus.de_catechizandis_rudibus","w":"augustinus.de_catechizandis_rudibus","a":"augustinus_von_hippo","s":24,"p":[1,1],"r":[13,18],"k":"quotation","m":"editionCitation","c":"high","cited":"Adopting the Benedictine version, qui eos mansuetus passus fuerat , and taking it as a parallel to Acts xiii. 18, Heb. xii. 3. There is, however, great variety of reading here. Thus we find qui ante eos , etc. = who had suffered in meekness before them: qui pro eis , etc. = who had suffered in their stead: qui propter eos , etc. = who had suffered on their account: and qui per eos , etc. = who had suffered through them, etc. But the reading in the text appears best authenticated."},{"id":"8062c8c07a93","b":"HEB","v":"npnf.augustinus.de_catechizandis_rudibus","w":"augustinus.de_catechizandis_rudibus","a":"augustinus_von_hippo","s":24,"p":[1,1],"r":[12,3],"k":"quotation","m":"editionCitation","c":"high","cited":"Adopting the Benedictine version, qui eos mansuetus passus fuerat , and taking it as a parallel to Acts xiii. 18, Heb. xii. 3. There is, however, great variety of reading here. Thus we find qui ante eos , etc. = who had suffered in meekness before them: qui pro eis , etc. = who had suffered in their stead: qui propter eos , etc. = who had suffered on their account: and qui per eos , etc. = who had suffered through them, etc. But the reading in the text appears best authenticated."},{"id":"66226aa9e51d","b":"PSA","v":"npnf.augustinus.de_catechizandis_rudibus","w":"augustinus.de_catechizandis_rudibus","a":"augustinus_von_hippo","s":24,"p":[2,2],"r":[118,22],"k":"quotation","m":"editionCitation","c":"medium","cited":"Ps. cxviii. 22; Isa. xxviii. 16."},{"id":"b80e198403dc","b":"ISA","v":"npnf.augustinus.de_catechizandis_rudibus","w":"augustinus.de_catechizandis_rudibus","a":"augustinus_von_hippo","s":24,"p":[2,2],"r":[28,16],"k":"quotation","m":"editionCitation","c":"high","cited":"Ps. cxviii. 22; Isa. xxviii. 16."},{"id":"08eafab4f308",