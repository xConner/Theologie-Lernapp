rules_version = '2';

// theologie.app – Firestore Security Rules
//
// Ownership-Modell: jeder Nutzer darf ausschließlich sein eigenes
// users/{uid}-Dokument und die Subcollections darunter lesen/schreiben.
// Deckt die im Code verwendeten Pfade ab:
//   users/{uid}                                (Felder: greek_grammar_settings, vocabulary_settings,
//                                               notification_settings, ...)
//   users/{uid}/quiz_settings/perikopen
//   users/{uid}/vocabulary/{vocabularyId}
//   users/{uid}/learning_cards/{cardId}
//   users/{uid}/latin_vocabulary/{cardId}
//   users/{uid}/grammar/{grammarId}
//   users/{uid}/pericope_overrides/config
//   users/{uid}/streaks/{trackId}
//   users/{uid}/statistics/{trainerId}          (Tagesstatistik je Trainer)
//   users/{uid}/notification_state/inbox       (Lesestatus der Glocke)
//   users/{uid}/push_tokens/{token}            (FCM-Tokens, vorbereitet)
//
// Benachrichtigungen (siehe docs/notifications.md):
//   notifications/{id}         globale Nachrichten: für alle lesbar (auch
//                              Gäste), vom Client NICHT schreibbar –
//                              Veröffentlichung nur über Console/Admin SDK.
//   users/{uid}/inbox/{id}     persönliche Nachrichten (Account &
//                              Sicherheit): nur der Nutzer darf lesen und
//                              löschen (Kontolöschung), anlegen/ändern nur
//                              der Server (Admin SDK).
//
// Kontolöschung (lib/services/account_deletion_service.dart) löscht alle
// hier genannten Subcollections und das users/{uid}-Dokument.
//
// Fehlermeldungen (siehe docs/info-and-reports.md):
//   reports/{id}               von jedem anlegbar (nur gültige Felder,
//                              begrenzte Längen, ohne Nutzerbezug), vom
//                              Client weder lesbar noch änderbar.
//
// Diese Datei ist die Referenz für die Regeln, die manuell in der Firebase
// Console unter Firestore Database -> Regeln eingetragen werden müssen
// (dieses Projekt hat kein lokales Firebase-CLI-Setup/firebase.json).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if false;
    }

    // Muss zu Report.toMap() in lib/services/reports/report.dart passen.
    function isValidReport(d) {
      return d.keys().hasOnly(['kind', 'category', 'description', 'area',
                               'areaTitle', 'context', 'appVersion',
                               'platform', 'createdAt'])
        && d.keys().hasAll(['kind', 'category', 'description', 'area',
                            'areaTitle', 'context', 'appVersion',
                            'platform', 'createdAt'])
        && d.kind == 'report'
        && d.category in ['bug', 'content', 'reference', 'translation',
                          'source', 'display', 'other']
        && d.description is string
        && d.description.size() >= 3 && d.description.size() <= 2000
        && d.area is string && d.area.size() > 0 && d.area.size() <= 60
        && d.areaTitle is string && d.areaTitle.size() <= 80
        && d.context is string && d.context.size() <= 1500
        && d.appVersion is string && d.appVersion.size() <= 30
        && d.platform is string && d.platform.size() <= 30
        && d.createdAt == request.time;
    }

    // Fehlermeldungen: jeder (auch Gäste) darf eine gültige Meldung anlegen,
    // niemand darf über den Client lesen, ändern oder löschen. Auswertung
    // nur über Console/Admin SDK.
    match /reports/{reportId} {
      allow create: if isValidReport(request.resource.data);
      allow read, update, delete: if false;
    }

    // Felder, die der Client im users/{uid}-Dokument setzen darf (alle
    // Schreibzugriffe im Code verwenden set(..., merge: true) mit genau
    // einem dieser Felder). Geprüft werden nur die GEÄNDERTEN Felder, damit
    // ältere, bereits vorhandene Felder bestehende Dokumente nicht sperren.
    function userDocKeys() {
      return ['vocabulary_settings', 'latin_vocabulary_settings',
              'greek_grammar_settings', 'notification_settings'];
    }

    function changedKeys() {
      return resource == null
        ? request.resource.data.keys()
        : request.resource.data.diff(resource.data).affectedKeys();
    }

    // Subcollections unter users/{uid}, die der Client verwendet
    // (siehe Liste oben; "inbox" ist bewusst nicht enthalten).
    function isUserCollection(collection) {
      return collection in ['quiz_settings', 'vocabulary', 'learning_cards',
                            'latin_vocabulary', 'grammar',
                            'pericope_overrides', 'streaks', 'statistics',
                            'notification_state', 'push_tokens'];
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && changedKeys().hasOnly(userDocKeys());

      // Persönliche Nachrichten schreibt nur der Server. Löschen darf der
      // Nutzer sie selbst (nötig für die Kontolöschung).
      match /inbox/{notificationId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }

      // Nur die bekannten Subcollections, je eine Dokumentebene tief.
      match /{collection}/{documentId} {
        allow read, write: if isOwner(uid) && isUserCollection(collection);
      }
    }
  }
}
